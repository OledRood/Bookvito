### Ignored files for the `web` (frontend) folder — Vite / React / Node
# Keep this file inside `web/` so rules apply only to the frontend package.

# Node modules and package manager logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/
.out/
.next/

# Vite and caching
.vite/
.vite
.cache/
.parcel-cache/

# Environment variables (local secrets)
.env
.env.*
# if you keep an example env in repo, allow it explicitly
!/.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDEs and OS files
.DS_Store
.vscode/
.idea/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*

# Test coverage
coverage/
.nyc_output/
test-results/
playwright-report/

# Misc
.cache-loader
.pnp.*
*.tgz
*.local

# Optional: editor swap files
*~
*.swp

# Ignore build artifacts from various tools
dist-*/
build-*/
